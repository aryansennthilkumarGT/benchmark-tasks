#usda 1.0
(
    defaultPrim = "Asset"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Asset" (
    prepend apiSchemas = ["PhysicsArticulationRootAPI"]
)
{
    def Material "Material" (
        prepend apiSchemas = ["PhysicsMaterialAPI"]
    )
    {
        float physics:dynamicFriction = 0.5
        float physics:restitution = 0
        float physics:staticFriction = 0.65
    }

    def Xform "plug_2" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        float physics:mass = 0.016
        quatf xformOp:orient = (1, 0, 0, 0)
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]

        def Cube "shape_0" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
        )
        {
            rel material:binding:physics = </Asset/Material>
            color3f[] primvars:displayColor = [(0.15, 0.7, 0.28)]
            double size = 1
            quatf xformOp:orient = (1, 0, 0, 0)
            float3 xformOp:scale = (0.022, 0.034, 0.019)
            double3 xformOp:translate = (0, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
        }

        def Cube "shape_1" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
        )
        {
            rel material:binding:physics = </Asset/Material>
            color3f[] primvars:displayColor = [(0.15, 0.7, 0.28)]
            double size = 1
            quatf xformOp:orient = (1, 0, 0, 0)
            float3 xformOp:scale = (0.014, 0.015, 0.014)
            double3 xformOp:translate = (0, 0.022, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
        }
    }

    def Xform "latch_2" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        float physics:mass = 0.002
        quatf xformOp:orient = (1, 0, 0, 0)
        double3 xformOp:translate = (0, 0.008999999999999994, 0.01100000000000001)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]

        def Cube "shape_0" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
        )
        {
            rel material:binding:physics = </Asset/Material>
            color3f[] primvars:displayColor = [(0.95, 0.42, 0.06)]
            double size = 1
            quatf xformOp:orient = (1, 0, 0, 0)
            float3 xformOp:scale = (0.012, 0.028, 0.003)
            double3 xformOp:translate = (0, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
        }
    }

    def PhysicsPrismaticJoint "latch_slide_2" (
        prepend apiSchemas = ["PhysicsDriveAPI:linear"]
    )
    {
        float drive:linear:physics:damping = 0.5
        float drive:linear:physics:stiffness = 150
        float drive:linear:physics:targetPosition = 0
        uniform token drive:linear:physics:type = "force"
        uniform token physics:axis = "Z"
        rel physics:body0 = </Asset/plug_2>
        rel physics:body1 = </Asset/latch_2>
        bool physics:collisionEnabled = 0
        point3f physics:localPos0 = (0, 0.009, 0.011)
        point3f physics:localPos1 = (0, 0, 0)
        float physics:lowerLimit = -0.004
        float physics:upperLimit = 0
    }
}

