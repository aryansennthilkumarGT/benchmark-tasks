    def PhysicsPrismaticJoint "plate_preload" (
        prepend apiSchemas = ["PhysicsDriveAPI:linear"]
    )
    {
        float drive:linear:physics:damping = 2
        float drive:linear:physics:stiffness = 400
        float drive:linear:physics:targetPosition = 0
        uniform token drive:linear:physics:type = "force"
        uniform token physics:axis = "Z"
        rel physics:body0 = </Asset/bracket>
        rel physics:body1 = </Asset/plate_carrier>
        bool physics:collisionEnabled = 0
        point3f physics:localPos0 = (0, 0, 0.022)
        point3f physics:localPos1 = (0, 0, 0)
        quatf physics:localRot0 = (1, 0, 0, 0)
        quatf physics:localRot1 = (1, 0, 0, 0)
        float physics:lowerLimit = -0.014
        float physics:upperLimit = 0.002
    }

