#usda 1.0
(
    defaultPrim = "Asset"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Asset"
{
    def Material "Material" (
        prepend apiSchemas = ["PhysicsMaterialAPI"]
    )
    {
        float physics:dynamicFriction = 0.5
        float physics:restitution = 0
        float physics:staticFriction = 0.65
    }

    def Xform "captive_shaft" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        float physics:mass = 1.2
        quatf xformOp:orient = (1, 0, 0, 0)
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]

        def Cylinder "shape_0" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
        )
        {
            uniform token axis = "Z"
            double height = 0.22
            rel material:binding:physics = </Asset/Material>
            color3f[] primvars:displayColor = [(0.52, 0.55, 0.6)]
            double radius = 0.01
            quatf xformOp:orient = (0.70710677, 0.70710677, 0, 0)
            double3 xformOp:translate = (0, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
        }

        def Cylinder "shape_1" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
        )
        {
            uniform token axis = "Z"
            double height = 0.01
            rel material:binding:physics = </Asset/Material>
            color3f[] primvars:displayColor = [(0.08, 0.35, 0.85)]
            double radius = 0.026
            quatf xformOp:orient = (0.70710677, 0.70710677, 0, 0)
            double3 xformOp:translate = (0, -0.1, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
        }

        def Cylinder "shape_2" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
        )
        {
            uniform token axis = "Z"
            double height = 0.01
            rel material:binding:physics = </Asset/Material>
            color3f[] primvars:displayColor = [(0.08, 0.35, 0.85)]
            double radius = 0.026
            quatf xformOp:orient = (0.70710677, 0.70710677, 0, 0)
            double3 xformOp:translate = (0, 0.1, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
        }

        def Cube "shape_3" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
        )
        {
            rel material:binding:physics = </Asset/Material>
            color3f[] primvars:displayColor = [(0.52, 0.55, 0.6)]
            double size = 1
            quatf xformOp:orient = (1, 0, 0, 0)
            float3 xformOp:scale = (0.05, 0.02, 0.08)
            double3 xformOp:translate = (0, -0.115, -0.035)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
        }

        def Cube "shape_4" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
        )
        {
            rel material:binding:physics = </Asset/Material>
            color3f[] primvars:displayColor = [(0.52, 0.55, 0.6)]
            double size = 1
            quatf xformOp:orient = (1, 0, 0, 0)
            float3 xformOp:scale = (0.05, 0.02, 0.08)
            double3 xformOp:translate = (0, 0.115, -0.035)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
        }

        def Cube "shape_5" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
        )
        {
            rel material:binding:physics = </Asset/Material>
            color3f[] primvars:displayColor = [(0.18, 0.36, 0.5)]
            double size = 1
            quatf xformOp:orient = (1, 0, 0, 0)
            float3 xformOp:scale = (0.0024, 0.18, 0.004)
            double3 xformOp:translate = (0, 0, 0.0107)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
        }

        def Cylinder "shape_6" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
        )
        {
            uniform token axis = "Z"
            double height = 0.004
            rel material:binding:physics = </Asset/Material>
            color3f[] primvars:displayColor = [(0.52, 0.55, 0.6)]
            double radius = 0.019
            quatf xformOp:orient = (0.70710677, 0.70710677, 0, 0)
            double3 xformOp:translate = (0, -0.0175, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
        }

        def Cylinder "shape_7" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
        )
        {
            uniform token axis = "Z"
            double height = 0.004
            rel material:binding:physics = </Asset/Material>
            color3f[] primvars:displayColor = [(0.52, 0.55, 0.6)]
            double radius = 0.019
            quatf xformOp:orient = (0.70710677, 0.70710677, 0, 0)
            double3 xformOp:translate = (0, 0.0175, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
        }
    }

    def PhysicsFixedJoint "fix_captive_shaft" (
        prepend apiSchemas = ["PhysicsArticulationRootAPI"]
    )
    {
        rel physics:body0 = </Asset>
        rel physics:body1 = </Asset/captive_shaft>
        point3f physics:localPos0 = (0, 0, 0)
        quatf physics:localRot0 = (1, 0, 0, 0)
    }
}

