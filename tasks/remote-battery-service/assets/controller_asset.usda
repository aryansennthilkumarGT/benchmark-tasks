    def PhysicsPrismaticJoint "cover_slide" (
        prepend apiSchemas = ["PhysicsDriveAPI:linear"]
    )
    {
        float drive:linear:physics:damping = 0.04
        float drive:linear:physics:stiffness = 0.2
        float drive:linear:physics:targetPosition = 0
        uniform token drive:linear:physics:type = "force"
        uniform token physics:axis = "X"
        rel physics:body0 = </Asset/controller>
        rel physics:body1 = </Asset/cover>
        bool physics:collisionEnabled = 0
        point3f physics:localPos0 = (0, 0, 0.034)
        point3f physics:localPos1 = (0, 0, 0)
        float physics:lowerLimit = 0
        float physics:upperLimit = 0.11
    }

    def PhysicsPrismaticJoint "spring_0" (
        prepend apiSchemas = ["PhysicsDriveAPI:linear"]
    )
    {
        float drive:linear:physics:damping = 0.5
        float drive:linear:physics:stiffness = 50
        float drive:linear:physics:targetPosition = 0
        uniform token drive:linear:physics:type = "force"
        uniform token physics:axis = "X"
        rel physics:body0 = </Asset/controller>
        rel physics:body1 = </Asset/contact_0>
