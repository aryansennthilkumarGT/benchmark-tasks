#usda 1.0
(
    defaultPrim = "Asset"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Asset"
{
    def Material "Material" (
        prepend apiSchemas = ["PhysicsMaterialAPI"]
    )
    {
        float physics:dynamicFriction = 0.5
        float physics:restitution = 0
        float physics:staticFriction = 0.65
    }

    def Xform "retainer_tray" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        point3f physics:centerOfMass = (0, -0.01, 0.0225)
        float3 physics:diagonalInertia = (0.00028908334, 0.00343575, 0.0033873334)
        float physics:mass = 1
        quatf xformOp:orient = (1, 0, 0, 0)
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]

        def Cylinder "shape_0" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
        )
        {
            uniform token axis = "Z"
            double height = 0.045
            rel material:binding:physics = </Asset/Material>
            color3f[] primvars:displayColor = [(0.12, 0.34, 0.58)]
            double radius = 0.009
            quatf xformOp:orient = (1, 0, 0, 0)
            double3 xformOp:translate = (-0.09, 0, 0.0225)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
        }

        def Cylinder "shape_1" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
        )
        {
            uniform token axis = "Z"
            double height = 0.045
            rel material:binding:physics = </Asset/Material>
            color3f[] primvars:displayColor = [(0.12, 0.34, 0.58)]
            double radius = 0.009
            quatf xformOp:orient = (1, 0, 0, 0)
            double3 xformOp:translate = (0, -0.020000000000000018, 0.0225)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
        }

        def Cylinder "shape_2" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
        )
        {
            uniform token axis = "Z"
            double height = 0.045
            rel material:binding:physics = </Asset/Material>
            color3f[] primvars:displayColor = [(0.12, 0.34, 0.58)]
            double radius = 0.009
            quatf xformOp:orient = (1, 0, 0, 0)
            double3 xformOp:translate = (0.09, 0, 0.0225)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
        }
    }

    def PhysicsFixedJoint "fix_retainer_tray" (
        prepend apiSchemas = ["PhysicsArticulationRootAPI"]
    )
    {
        rel physics:body0 = </Asset>
        rel physics:body1 = </Asset/retainer_tray>
        point3f physics:localPos0 = (0, 0, 0)
        quatf physics:localRot0 = (1, 0, 0, 0)
    }
}

