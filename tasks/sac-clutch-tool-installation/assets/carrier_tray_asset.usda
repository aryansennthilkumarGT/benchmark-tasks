#usda 1.0
(
    defaultPrim = "Asset"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Asset"
{
    def Material "Material" (
        prepend apiSchemas = ["PhysicsMaterialAPI"]
    )
    {
        float physics:dynamicFriction = 0.5
        float physics:restitution = 0
        float physics:staticFriction = 0.65
    }

    def Xform "carrier_tray" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        point3f physics:centerOfMass = (0.0095, 3.469447e-18, -0.035)
        float3 physics:diagonalInertia = (0.0009937871, 0.00087708334, 0.0010542038)
        float physics:mass = 1
        quatf xformOp:orient = (1, 0, 0, 0)
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]

        def Cube "shape_0" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
        )
        {
            rel material:binding:physics = </Asset/Material>
            color3f[] primvars:displayColor = [(0.12, 0.34, 0.58)]
            double size = 1
            quatf xformOp:orient = (1, 0, 0, 0)
            float3 xformOp:scale = (0.018, 0.018, 0.07)
            double3 xformOp:translate = (0.038, 0, -0.035)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
        }

        def Cube "shape_1" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
        )
        {
            rel material:binding:physics = </Asset/Material>
            color3f[] primvars:displayColor = [(0.12, 0.34, 0.58)]
            double size = 1
            quatf xformOp:orient = (1, 0, 0, 0)
            float3 xformOp:scale = (0.018, 0.018, 0.07)
            double3 xformOp:translate = (-0.018999999999999993, 0.03290896534380867, -0.035)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
        }

        def Cube "shape_2" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
        )
        {
            rel material:binding:physics = </Asset/Material>
            color3f[] primvars:displayColor = [(0.12, 0.34, 0.58)]
            double size = 1
            quatf xformOp:orient = (1, 0, 0, 0)
            float3 xformOp:scale = (0.018, 0.018, 0.07)
            double3 xformOp:translate = (-0.019000000000000017, -0.03290896534380866, -0.035)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
        }
    }

    def PhysicsFixedJoint "fix_carrier_tray" (
        prepend apiSchemas = ["PhysicsArticulationRootAPI"]
    )
    {
        rel physics:body0 = </Asset>
        rel physics:body1 = </Asset/carrier_tray>
        point3f physics:localPos0 = (0, 0, 0)
        quatf physics:localRot0 = (1, 0, 0, 0)
    }
}

