#usda 1.0
(
    defaultPrim = "Asset"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Asset"
{
    def Material "Material" (
        prepend apiSchemas = ["PhysicsMaterialAPI"]
    )
    {
        float physics:dynamicFriction = 0.5
        float physics:restitution = 0
        float physics:staticFriction = 0.65
    }

    def Xform "cell_8" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        float physics:mass = 0.024
        quatf xformOp:orient = (1, 0, 0, 0)
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]

        def Cylinder "shape_0" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
        )
        {
            uniform token axis = "Z"
            double height = 0.0505
            rel material:binding:physics = </Asset/Material>
            color3f[] primvars:displayColor = [(0.08, 0.35, 0.85)]
            double radius = 0.00725
            quatf xformOp:orient = (1, 0, 0, 0)
            double3 xformOp:translate = (0, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
        }

        def Cylinder "shape_1" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
        )
        {
            uniform token axis = "Z"
            double height = 0.0015
            rel material:binding:physics = </Asset/Material>
            color3f[] primvars:displayColor = [(0.95, 0.42, 0.06)]
            double radius = 0.0028
            quatf xformOp:orient = (1, 0, 0, 0)
            double3 xformOp:translate = (0, 0, 0.0258)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
        }

        def Cube "shape_2"
        {
            color3f[] primvars:displayColor = [(0.9, 0.9, 0.9)]
            double size = 1
            quatf xformOp:orient = (1, 0, 0, 0)
            float3 xformOp:scale = (0.022, 0.005, 0.0002)
            double3 xformOp:translate = (0, 0, 0.0074)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
        }
    }
}

