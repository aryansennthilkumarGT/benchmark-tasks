    def PhysicsRevoluteJoint "lid_hinge" (
        prepend apiSchemas = ["PhysicsDriveAPI:angular"]
    )
    {
        float drive:angular:physics:damping = 0.003
        float drive:angular:physics:stiffness = 0
        float drive:angular:physics:targetPosition = 0
        uniform token drive:angular:physics:type = "force"
        uniform token physics:axis = "Y"
        rel physics:body0 = </Asset/chassis>
        rel physics:body1 = </Asset/lid>
        bool physics:collisionEnabled = 0
        point3f physics:localPos0 = (0.1, 0, 0.064)
        point3f physics:localPos1 = (0, 0, 0)
        float physics:lowerLimit = 0
        float physics:upperLimit = 77.349304
